// The settings panel behind the gear button: categories in the sidebar,
// each with titled sections of settings. Every setting edits one Ghostty
// config key: picking a choice writes `key = value` to the user's config
// file and reloads it. An empty value removes the key, so Ghostty's
// default applies again. The file is checked when Sharp is compiled.
//
// .icon is a Segoe Fluent Icons code point.
//
// A setting is one of:
//   a dropdown   .choices = .{ .{ .label, .value }, ... }, or .profiles =
//                true to offer the installed shells from profiles.zon
//   a toggle     .on / .off values, .default_on when the key is absent
//   an action    .action = .edit_file or .reload, with a .button label
//
// Choices can name a font they need; they are hidden when it is missing:
//   .requires_font     an installed font family
.{
    .title = "Settings",
    .search_placeholder = "Search",
    .restore_label = "Restore defaults",
    .restore_confirm = "Remove every setting changed from this panel and go back to the defaults?",
    .no_results = "No settings match your search.",
    .categories = .{
        .{
            .name = "General",
            .icon = 0xE713,
            .sections = .{
                .{
                    .title = "Layout",
                    .settings = .{
                        .{
                            // Workspace also reopens its tabs at the next start.
                            .label = "Mode",
                            .description = "Tabs on top, or folders at the side.",
                            .key = "window-tab-bar-position",
                            .choices = .{
                                .{ .label = "Tabs", .value = "" },
                                .{ .label = "Workspace", .value = "sidebar" },
                            },
                        },
                    },
                },
                .{
                    .title = "New tabs",
                    .settings = .{
                        .{
                            .label = "Shell",
                            .description = "The program new tabs and windows start. Open tabs keep theirs.",
                            .key = "command",
                            // The choices are the installed shells from profiles.zon.
                            .profiles = true,
                        },
                    },
                },
                .{
                    .title = "Behavior",
                    .settings = .{
                        .{
                            .label = "Confirm before closing",
                            .description = "Ask before closing a tab or window that is still running a command.",
                            .key = "confirm-close-surface",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "Copy on select",
                            .description = "Copy selected text to the clipboard as soon as you select it.",
                            .key = "copy-on-select",
                            .on = "clipboard",
                            .off = "",
                            .default_on = false,
                        },
                    },
                },
            },
        },
        .{
            .name = "Appearance",
            .icon = 0xE790,
            .sections = .{
                .{
                    .title = "Colors",
                    .settings = .{
                        .{
                            .label = "Theme",
                            .description = "Colors for the terminal and the tab strip.",
                            .key = "theme",
                            .choices = .{
                                .{ .label = "Default", .value = "" },
                                .{ .label = "Catppuccin Mocha", .value = "Catppuccin Mocha" },
                                .{ .label = "Catppuccin Latte", .value = "Catppuccin Latte" },
                                .{ .label = "Dracula", .value = "Dracula" },
                                .{ .label = "Nord", .value = "Nord" },
                                .{ .label = "Gruvbox Dark", .value = "Gruvbox Dark" },
                                .{ .label = "Tokyo Night", .value = "TokyoNight" },
                                .{ .label = "Rose Pine", .value = "Rose Pine" },
                                .{ .label = "Kanagawa Wave", .value = "Kanagawa Wave" },
                                .{ .label = "Monokai Pro", .value = "Monokai Pro" },
                                .{ .label = "One Half Dark", .value = "One Half Dark" },
                                .{ .label = "Solarized Dark", .value = "iTerm2 Solarized Dark" },
                                .{ .label = "GitHub Dark", .value = "GitHub Dark Default" },
                                .{ .label = "GitHub Light", .value = "GitHub Light Default" },
                            },
                        },
                        .{
                            .label = "Tab style",
                            .description = "Chrome's flowing tabs, or Windows Terminal's flat ones. Tabs mode only.",
                            .key = "window-tab-style",
                            .choices = .{
                                .{ .label = "Chrome", .value = "" },
                                .{ .label = "Windows Terminal", .value = "windows-terminal" },
                            },
                        },
                    },
                },
                .{
                    .title = "Background",
                    .settings = .{
                        .{
                            .label = "Style",
                            .description = "The plain theme color, or a pixel cascade fading down from the top.",
                            .key = "background-style",
                            .choices = .{
                                .{ .label = "Default", .value = "" },
                                .{ .label = "Pixel cascade", .value = "pixel-cascade" },
                            },
                        },
                        .{
                            .label = "Pattern color",
                            .description = "The color of the style's pattern. Any #RRGGBB works in the config file.",
                            .key = "background-style-color",
                            .choices = .{
                                .{ .label = "Text color", .value = "" },
                                .{ .label = "White", .value = "#ffffff" },
                                .{ .label = "Blue", .value = "#5b8cff" },
                                .{ .label = "Purple", .value = "#a78bfa" },
                                .{ .label = "Pink", .value = "#f472b6" },
                                .{ .label = "Green", .value = "#4ade80" },
                                .{ .label = "Orange", .value = "#fb923c" },
                                .{ .label = "Cyan", .value = "#22d3ee" },
                            },
                        },
                    },
                },
            },
        },
        .{
            .name = "Text",
            .icon = 0xE8D2,
            .sections = .{
                .{
                    .title = "Font",
                    .settings = .{
                        .{
                            .label = "Font family",
                            .description = "The typeface for terminal text. Only installed fonts are listed.",
                            .key = "font-family",
                            .choices = .{
                                .{ .label = "JetBrains Mono", .value = "" },
                                .{ .label = "Cascadia Mono", .value = "Cascadia Mono", .requires_font = "Cascadia Mono" },
                                .{ .label = "Cascadia Code", .value = "Cascadia Code", .requires_font = "Cascadia Code" },
                                .{ .label = "Consolas", .value = "Consolas", .requires_font = "Consolas" },
                                .{ .label = "Fira Code", .value = "Fira Code", .requires_font = "Fira Code" },
                                .{ .label = "Lucida Console", .value = "Lucida Console", .requires_font = "Lucida Console" },
                            },
                        },
                        .{
                            .label = "Font size",
                            .description = "Text size in points. Ctrl+Plus and Ctrl+Minus change it for one tab.",
                            .key = "font-size",
                            .choices = .{
                                .{ .label = "10", .value = "10" },
                                .{ .label = "11", .value = "11" },
                                .{ .label = "12", .value = "" },
                                .{ .label = "13", .value = "13" },
                                .{ .label = "14", .value = "14" },
                                .{ .label = "16", .value = "16" },
                                .{ .label = "18", .value = "18" },
                                .{ .label = "20", .value = "20" },
                            },
                        },
                    },
                },
                .{
                    .title = "Cursor",
                    .settings = .{
                        .{
                            .label = "Cursor style",
                            .description = "Programs can still change it while they run.",
                            .key = "cursor-style",
                            .choices = .{
                                .{ .label = "Block", .value = "" },
                                .{ .label = "Bar", .value = "bar" },
                                .{ .label = "Underline", .value = "underline" },
                                .{ .label = "Hollow block", .value = "block_hollow" },
                            },
                        },
                        .{
                            .label = "Blinking cursor",
                            .description = "Make the cursor blink while the terminal has focus.",
                            .key = "cursor-style-blink",
                            .on = "true",
                            .off = "false",
                            .default_on = true,
                        },
                    },
                },
            },
        },
        .{
            .name = "AI",
            .icon = 0xE9D9,
            .sections = .{
                .{
                    .title = "Claude",
                    .settings = .{
                        .{
                            .label = "Show Claude",
                            .description = "Your Claude plan's limits in the sidebar, read from Claude Code.",
                            .key = "ai-usage-claude",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "5-hour limit",
                            .description = "How much of the current 5-hour window is used.",
                            .key = "ai-usage-claude-session",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "Weekly limit",
                            .description = "How much of this week's limit is used.",
                            .key = "ai-usage-claude-weekly",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "Per-model limits",
                            .description = "The weekly limits of single models, such as Fable.",
                            .key = "ai-usage-claude-models",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                    },
                },
                .{
                    .title = "Codex",
                    .settings = .{
                        .{
                            .label = "Show Codex",
                            .description = "Your ChatGPT plan's limits in the sidebar, read from Codex.",
                            .key = "ai-usage-codex",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "5-hour or monthly limit",
                            .description = "The plan's short window: 5 hours, or a month on the Free plan.",
                            .key = "ai-usage-codex-session",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "Weekly limit",
                            .description = "How much of this week's limit is used.",
                            .key = "ai-usage-codex-weekly",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                        .{
                            .label = "Per-model limits",
                            .description = "The limits of single models, beside the plan's own.",
                            .key = "ai-usage-codex-models",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                    },
                },
                .{
                    .title = "OpenCode",
                    .settings = .{
                        .{
                            .label = "Show OpenCode",
                            .description = "What OpenCode spent today and this week.",
                            .key = "ai-usage-opencode",
                            .on = "",
                            .off = "false",
                            .default_on = true,
                        },
                    },
                },
                .{
                    .title = "Tools",
                    .settings = .{
                        .{
                            .label = "Browser",
                            .description = "A browser beside the terminal that Claude can see and use.",
                            .key = "ai-tools-browser",
                            .on = "true",
                            .off = "",
                            .default_on = false,
                        },
                        .{
                            .label = "Search engine",
                            .description = "Where new browser tabs open and typed words are looked up.",
                            .key = "browser-search-engine",
                            .choices = .{
                                .{ .label = "Google", .value = "" },
                                .{ .label = "DuckDuckGo", .value = "duckduckgo" },
                            },
                        },
                    },
                },
            },
        },
        .{
            .name = "Advanced",
            .icon = 0xE90F,
            .sections = .{
                .{
                    .title = "Config file",
                    .settings = .{
                        .{
                            .label = "Edit config file",
                            .description = "Every Ghostty option, including the ones not shown here, lives in this text file.",
                            .action = .edit_file,
                            .button = "Open",
                        },
                        .{
                            .label = "Reload config",
                            .description = "Apply changes you made to the file by hand.",
                            .action = .reload,
                            .button = "Reload",
                        },
                    },
                },
            },
        },
    },
}
