// The settings menu behind the gear button. Each entry edits one Ghostty
// config key: picking a choice writes `key = value` to the user's config
// file and reloads it. An empty value removes the key, so Ghostty's
// default applies again. The file is checked when Sharp is compiled.
//
// Choices can name what they need to be useful; they are hidden when it
// is missing:
//   .requires_program  an executable on PATH, or an absolute path
//   .requires_font     an installed font family
//
// A toggle is an entry with .on/.off values instead of choices.
// .default_on says what the setting is when the key is not in the file.
.{
    .entries = .{
        .{
            .label = "Theme",
            .key = "theme",
            .choices = .{
                .{ .label = "Default", .value = "" },
                .{ .label = "Catppuccin Mocha", .value = "Catppuccin Mocha" },
                .{ .label = "Catppuccin Latte", .value = "Catppuccin Latte" },
                .{ .label = "Dracula", .value = "Dracula" },
                .{ .label = "Nord", .value = "Nord" },
                .{ .label = "Gruvbox Dark", .value = "Gruvbox Dark" },
                .{ .label = "Tokyo Night", .value = "TokyoNight" },
                .{ .label = "Rose Pine", .value = "Rose Pine" },
                .{ .label = "Kanagawa Wave", .value = "Kanagawa Wave" },
                .{ .label = "Monokai Pro", .value = "Monokai Pro" },
                .{ .label = "One Half Dark", .value = "One Half Dark" },
                .{ .label = "Solarized Dark", .value = "iTerm2 Solarized Dark" },
                .{ .label = "GitHub Dark", .value = "GitHub Dark Default" },
                .{ .label = "GitHub Light", .value = "GitHub Light Default" },
            },
        },
        .{
            .label = "Font",
            .key = "font-family",
            .choices = .{
                .{ .label = "Default (JetBrains Mono)", .value = "" },
                .{ .label = "Cascadia Mono", .value = "Cascadia Mono", .requires_font = "Cascadia Mono" },
                .{ .label = "Cascadia Code", .value = "Cascadia Code", .requires_font = "Cascadia Code" },
                .{ .label = "Consolas", .value = "Consolas", .requires_font = "Consolas" },
                .{ .label = "Fira Code", .value = "Fira Code", .requires_font = "Fira Code" },
                .{ .label = "Lucida Console", .value = "Lucida Console", .requires_font = "Lucida Console" },
            },
        },
        .{
            .label = "Font size",
            .key = "font-size",
            .choices = .{
                .{ .label = "10", .value = "10" },
                .{ .label = "11", .value = "11" },
                .{ .label = "12 (default)", .value = "" },
                .{ .label = "13", .value = "13" },
                .{ .label = "14", .value = "14" },
                .{ .label = "16", .value = "16" },
                .{ .label = "18", .value = "18" },
                .{ .label = "20", .value = "20" },
            },
        },
        .{
            .label = "Shell for new tabs",
            .key = "command",
            .choices = .{
                .{ .label = "Command Prompt", .value = "" },
                .{ .label = "Windows PowerShell", .value = "powershell.exe", .requires_program = "powershell.exe" },
                .{ .label = "PowerShell 7", .value = "pwsh.exe", .requires_program = "pwsh.exe" },
                .{ .label = "WSL", .value = "wsl.exe", .requires_program = "wsl.exe" },
                .{
                    .label = "Git Bash",
                    .value = "\"C:\\Program Files\\Git\\bin\\bash.exe\" -i -l",
                    .requires_program = "C:\\Program Files\\Git\\bin\\bash.exe",
                },
            },
        },
        .{
            .label = "Cursor",
            .key = "cursor-style",
            .choices = .{
                .{ .label = "Block", .value = "" },
                .{ .label = "Bar", .value = "bar" },
                .{ .label = "Underline", .value = "underline" },
                .{ .label = "Hollow block", .value = "block_hollow" },
            },
        },
        .{
            .label = "Background opacity",
            .key = "background-opacity",
            .choices = .{
                .{ .label = "100%", .value = "" },
                .{ .label = "95%", .value = "0.95" },
                .{ .label = "90%", .value = "0.9" },
                .{ .label = "85%", .value = "0.85" },
                .{ .label = "80%", .value = "0.8" },
            },
        },
        .{ .label = "Blinking cursor", .key = "cursor-style-blink", .on = "true", .off = "false", .default_on = true },
        .{ .label = "Copy on select", .key = "copy-on-select", .on = "clipboard", .off = "", .default_on = false },
        .{ .label = "Confirm before closing", .key = "confirm-close-surface", .on = "", .off = "false", .default_on = true },
    },
    .edit_file_label = "Edit config file\u{2026}",
    .reload_label = "Reload config",
}
