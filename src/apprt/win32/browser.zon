// The browser panel beside the terminal, opened from the globe in the tab
// strip while Settings > AI > Tools > Browser is on. Checked when Sharp is
// compiled.
.{
    // The panel's share of the window, in percent (10 to 80), until its
    // edge is dragged, and its narrowest width in pixels at 96 DPI.
    .width_percent = 40,
    .min_width = 360,
    // Every page lays out at this size in CSS pixels, scaled to fit the
    // panel, so Claude sees the same desktop layout however wide the
    // panel is.
    .viewport_width = 1920,
    .viewport_height = 1080,
    // Each chat, or terminal pane, has its own tabs: up to max_tabs each,
    // and max_total_tabs in one panel.
    // What browser_action resize accepts, in CSS pixels.
    .viewport_limits = .{ .min_width = 320, .max_width = 3840, .min_height = 240, .max_height = 2160 },
    // The sizes the toolbar's page size menu offers. mobile switches to a
    // phone's identity and touch, and reloads the page.
    .viewports = .{
        .{ .name = "Desktop 1920 × 1080", .width = 1920, .height = 1080, .mobile = false },
        .{ .name = "Laptop 1440 × 900", .width = 1440, .height = 900, .mobile = false },
        .{ .name = "Small laptop 1280 × 800", .width = 1280, .height = 800, .mobile = false },
        .{ .name = "Tablet 820 × 1180", .width = 820, .height = 1180, .mobile = true },
        .{ .name = "Phone 390 × 844", .width = 390, .height = 844, .mobile = true },
        .{ .name = "Small phone 360 × 640", .width = 360, .height = 640, .mobile = true },
    },
    .max_tabs = 12,
    .max_total_tabs = 48,
    // Settings > AI > Tools > Search engine (`browser-search-engine`).
    // .id is the config value; the first is the default. New tabs open
    // .home, and words typed in the address box go to .search.
    .engines = .{
        .{ .id = "google", .name = "Google", .home = "https://www.google.com/", .search = "https://www.google.com/search?q=" },
        .{ .id = "duckduckgo", .name = "DuckDuckGo", .home = "https://duckduckgo.com/", .search = "https://duckduckgo.com/?q=" },
    },
    .address_placeholder = "Search or enter address",
    // A tab's name until its page has a title.
    .untitled = "New tab",
    // The bar a page's alert, confirm, prompt or "leave this page?" shows
    // in, above the page.
    .dialog = .{ .says = "This page says", .ok = "OK", .cancel = "Cancel", .leave = "Leave", .stay = "Stay" },
    // Shown in the panel while the terminal pane in front has no pages.
    .empty = "No pages for this terminal yet. + opens one.",
    // Shown in the panel when Windows has no WebView2 runtime.
    .unavailable = "The browser needs Microsoft Edge WebView2 Runtime.",
}
