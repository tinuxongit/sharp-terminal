// Shells offered by the new-tab dropdown (the arrow beside "+") and by
// Settings > General > Shell. Like Windows Terminal's profiles: the Nth
// shown profile also opens with Ctrl+Shift+N. Checked when Sharp is
// compiled.
//
// A profile's .command is what the tab runs, written like Ghostty's
// `command` setting. .icon names the program whose icon the tab and menu
// show: a name on PATH or an absolute path. A profile is hidden when
// .requires (same form) is missing.
//
// .source repeats a profile for what is installed:
//   .visual_studio  once per Visual Studio installation, newest first, as
//                   its installer records them; {vs} becomes its folder
//                   and {vs_year} its version (2022)
//   .wsl            once per WSL distribution; {distro} becomes its name
//
// .default marks the shell new tabs run when `command` is not set.
// .paths is how the shell writes a path, for files dropped on it: .windows
// (the default, cmd.exe), .powershell, .wsl (/mnt/c/...) or .msys
// (/c/..., Git Bash).
.{
    // Distributions WSL uses internally, hidden as in Windows Terminal.
    .hidden_wsl_prefixes = .{"docker-desktop"},
    .profiles = .{
        .{ .name = "Windows PowerShell", .command = "powershell.exe", .icon = "powershell.exe", .requires = "powershell.exe", .paths = .powershell },
        .{ .name = "Command Prompt", .command = "cmd.exe", .icon = "cmd.exe", .default = true },
        .{ .name = "PowerShell 7", .command = "pwsh.exe", .icon = "pwsh.exe", .requires = "pwsh.exe", .paths = .powershell },
        .{
            .name = "Git Bash",
            .command = "\"C:\\Program Files\\Git\\bin\\bash.exe\" -i -l",
            .icon = "C:\\Program Files\\Git\\git-bash.exe",
            .requires = "C:\\Program Files\\Git\\bin\\bash.exe",
            .paths = .msys,
        },
        .{
            .name = "Developer Command Prompt for VS {vs_year}",
            .source = .visual_studio,
            .command = "cmd.exe /k \"{vs}\\Common7\\Tools\\VsDevCmd.bat\"",
            .icon = "cmd.exe",
            .requires = "{vs}\\Common7\\Tools\\VsDevCmd.bat",
        },
        .{
            .name = "Developer PowerShell for VS {vs_year}",
            .source = .visual_studio,
            .command = "powershell.exe -NoExit -Command \"&{Import-Module '{vs}\\Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll'; Enter-VsDevShell -VsInstallPath '{vs}' -SkipAutomaticLocation}\"",
            .icon = "powershell.exe",
            .requires = "{vs}\\Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll",
            .paths = .powershell,
        },
        .{ .name = "{distro}", .source = .wsl, .command = "wsl.exe -d {distro}", .icon = "wsl.exe", .paths = .wsl },
    },
    // Up and Down recall commands typed in any tab of these shells, kept
    // in `sharp-cmd-history` beside the config file. cmd.exe forgets its
    // own when its tab closes; PowerShell and bash keep theirs.
    .history = .{
        .shells = .{"cmd.exe"},
        // How many commands are kept; older ones are dropped.
        .size = 1000,
        // A command containing one of these, in any case, is recalled
        // until Sharp quits but never written to the file, as PSReadLine
        // does.
        .private = .{ "password", "asplaintext", "token", "apikey", "secret" },
    },
    // The tab sidebar's text. Tabs are listed by where their shell runs.
    .sidebar = .{
        .search_placeholder = "Search",
        .local = "Local",
        .wsl = "WSL",
        .servers = "Servers",
        .pick_folder = "Open a tab in folder",
        .server_placeholder = "user@host",
        .no_servers = "No servers in ~/.ssh/config yet",
        // The menu a right-click on a folder's title opens. Removing
        // closes every tab in it, asking first if a command runs.
        .group_menu = .{
            .new_tab = "New Tab Here",
            .open_folder = "Open in File Explorer",
            .remove_folder = "Remove Folder",
        },
        // A server's menu (right-click on its title, or its arrow), the
        // folder picker it opens, and the servers found on this network.
        .server_menu = .{
            .new_tab = "New Tab on Server",
            .open_folder = "Open Folder on Server...",
            .sign_in = "Sign In Without Password",
            .remote_desktop = "Remote Desktop",
            .remove = "Remove Server",
            // The folder picker's first item, followed by the folder.
            .open_here = "Open Here",
            .parent_folder = "..",
            .no_folders = "No folders here",
            // Printed in the new tab once this PC's key is on the server.
            .signed_in = "Sharp: this PC now signs in to this server without a password.",
            .password_needed_title = "Sign in without a password?",
            .password_needed_text = "Browsing the server's folders needs a sign-in without a password. Set it up now? You type the password once, in a new tab.",
            .no_desktop_title = "No remote desktop on this server",
            .no_desktop_text = "Nothing answers on the remote desktop port (3389). Install xrdp on the server? A new tab runs the install with sudo (Debian or Ubuntu).",
            // The command that tab runs on the server.
            .install_desktop = "sudo apt install -y xrdp xorgxrdp && sudo systemctl enable --now xrdp; ",
            // The remote desktop port checked first, and how long to wait.
            .desktop_port = 3389,
            .desktop_timeout_ms = 1500,
            // SSH servers found by trying every address of this PC's
            // local networks, listed in the Servers menu.
            .nearby = "On this network",
            .searching = "Searching this network...",
            // The address box's hint once a found server is picked: only
            // the user is missing. {s} is the server's address.
            .user_for = "user for {s}",
        },
        // The AI section at the foot of the sidebar: Claude Code's plan
        // windows and OpenCode's spending, read through their CLIs.
        .ai = .{
            // How often both CLIs are asked, in minutes.
            .refresh_minutes = 5,
            // From this percentage a plan window's bar turns warning-colored.
            .warn_percent = 80,
            .warning_color = .{ .r = 0xE5, .g = 0x9B, .b = 0x3E },
            .title = "AI",
            // A card per tool, with its logo from logos.zon.
            .claude = "Claude Code",
            .codex = "Codex",
            .opencode = "OpenCode",
            .logos = .{ "claude", "openai", "opencode" },
            // A plan window reads "5-hour limit   71% left", a bar, then
            // "Resets in 1h 18m" (or "Resets Nov 24" a week or more away).
            // A single model's limit adds its name: "Weekly limit · Fable".
            .five_hours = "5-hour limit",
            .week = "Weekly limit",
            .month = "Monthly limit",
            .other_window = "Limit",
            .left = "left",
            .resets_in = "Resets in",
            .resets_on = "Resets",
            .months = .{ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" },
            // OpenCode's spending: "Today   $1.20", then "248k tokens".
            .today = "Today",
            .this_week = "This week",
            .tokens = "tokens",
            .no_plan_limits = "API key, no plan limits",
            .checking = "Checking…",
        },
    },
    .menu = .{
        // Shown after a profile's name: the 3rd profile is Ctrl+Shift+3.
        .profile_shortcut = "Ctrl+Shift+",
    },
}
