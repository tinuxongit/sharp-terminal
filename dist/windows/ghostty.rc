// Sharp — application resources.
// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "ghostty.manifest"

#define ID_ICON_GHOSTTY 1
ID_ICON_GHOSTTY ICON "sharp.ico"

// Version info — shown in Explorer's Properties → Details and read by the
// installer and the updater. The build defines SHARP_FILEVERSION and
// SHARP_VERSION_STR from dist/windows/VERSION (or a release's
// -Dsharp-version). The comma form is 16-bit fields: MAJOR,MINOR,PATCH,
// and a nightly's run number.
//
// VS_VERSION_INFO must resolve to numeric resource ID 1; winres.h
// normally defines it, but this file is compiled without it, so the
// block would otherwise become a named resource that GetFileVersionInfo
// and Explorer never find.
#define VS_VERSION_INFO 1
VS_VERSION_INFO VERSIONINFO
FILEVERSION    SHARP_FILEVERSION
PRODUCTVERSION SHARP_FILEVERSION
FILEFLAGSMASK  0x3F
FILEFLAGS      0x0
FILEOS         0x40004 // VOS_NT_WINDOWS32
FILETYPE       0x1     // VFT_APP
FILESUBTYPE    0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = U.S. English, 04B0 = Unicode codepage 1200
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sharp"
            VALUE "FileDescription",  "Sharp Terminal"
            VALUE "FileVersion",      SHARP_VERSION_STR
            VALUE "InternalName",     "sharp"
            VALUE "LegalCopyright",   "MIT License. See share\\licenses\\sharp\\LICENSE.txt."
            VALUE "OriginalFilename", "sharp.exe"
            VALUE "ProductName",      "Sharp Terminal"
            VALUE "ProductVersion",   SHARP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
